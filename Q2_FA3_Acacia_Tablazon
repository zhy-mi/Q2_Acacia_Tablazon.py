        "# Student Score Analyzer Mini-App\n",
        "\n",
        "scores_data = [85, 90, 78, 92, 88]\n",
        "\n",
        "def display_scores(scores):\n",
        "    print(\"\\n--- Current Student Scores ---\")\n",
        "    for i, s in enumerate(scores):\n",
        "        print(f\"Student #{i+1} (Index {i}): {s}\")\n",
        "\n",
        "def search_score(scores, target):\n",
        "    if target in scores:\n",
        "        idx = scores.index(target)\n",
        "        print(f\"✅ Score {target} found at Student #{idx+1} (Index {idx}).\")\n",
        "    else:\n",
        "        print(f\"❌ Score {target} not found in records.\")\n",
        "\n",
        "def compute_statistics(scores):\n",
        "    if not scores:\n",
        "        print(\"No scores available.\")\n",
        "        return\n",
        "    avg = sum(scores) / len(scores)\n",
        "    print(f\"\\n--- Score Statistics ---\")\n",
        "    print(f\"Total Students: {len(scores)}\")\n",
        "    print(f\"Average Score:  {avg:.2f}\")\n",
        "    print(f\"Highest Score:  {max(scores)}\")\n",
        "    print(f\"Lowest Score:   {min(scores)}\")\n",
        "\n",
        "def update_score(scores, index, new_score):\n",
        "    if 0 <= index < len(scores):\n",
        "        old_val = scores[index]\n",
        "        scores[index] = new_score\n",
        "        print(f\"✅ Updated Index {index}: {old_val} -> {new_score}\")\n",
        "    else:\n",
        "        print(f\"❌ Invalid index! Must be between 0 and {len(scores)-1}.\")\n",
        "\n",
        "def run_mini_app():\n",
        "    print(\"=== Welcome to Student Score Analyzer ===\")\n",
        "\n",
        "    # Demonstration Run\n",
        "    display_scores(scores_data)\n",
        "    compute_statistics(scores_data)\n",
        "\n",
        "    print(\"\\n--- Performing Search ---\")\n",
        "    search_score(scores_data, 92)\n",
        "\n",
        "    print(\"\\n--- Updating Score ---\")\n",
        "    update_score(scores_data, 2, 82) # Update 78 to 82\n",
        "\n",
        "    display_scores(scores_data)\n",
        "    compute_statistics(scores_data)\n",
        "\n",
        "# Run the Mini-App\n",
        "run_mini_app()\n"
